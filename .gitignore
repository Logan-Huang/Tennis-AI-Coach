# macOS
.DS_Store

# Xcode: per-user state. Scheme ordering, window layout, breakpoints. Local only.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Xcode: build output
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive

# Swift Package Manager
.build/
.swiftpm/
Packages/

# Recorded and rendered video. Large binaries do not belong in git, and every
# one of these is reproducible from the app or the notebook.
*.mov
*.MOV
*.mp4
*.m4v

# Generated analysis output.
#
# IMG_7145_analysis.json is deliberately NOT ignored: Scripts/scorer-harness
# reads it as its input fixture, so a fresh clone needs it to run the harness.
*_stats.txt

# AppsFlyer dev key. Kept out of this public repo: local builds read the file
# on this Mac, and Xcode Cloud writes it from the APPSFLYER_DEV_KEY secret
# (ci_scripts/ci_post_clone.sh). Without it the app never starts the SDK.
Tennis AI Coach/AppsFlyerKeys.plist
